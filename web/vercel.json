{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://saying-ink-surely-leon.trycloudflare.com/api/:path*" },
    { "source": "/mcp", "destination": "https://saying-ink-surely-leon.trycloudflare.com/mcp" },
    { "source": "/((?!assets/|.*\\.[a-z0-9]+$).*)", "destination": "/index.html" }
  ]
}
