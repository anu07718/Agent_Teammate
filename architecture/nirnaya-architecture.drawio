rtex="1" parent="c_be"><mxGeometry x="15" y="782" width="1230" height="136" as="geometry"/></mxCell><mxCell id="sys_82" value='&lt;b&gt;Groundedness Check&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;every claim cites an evidence id&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="b5"><mxGeometry x="27" y="38" width="220" height="62" as="geometry"/></mxCell><mxCell id="sys_83" value='&lt;b&gt;★ Promise Guard&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;never promises beyond policy —&lt;br&gt;amount · timeline · outcome&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6D5;strokeColor=#D69E00;strokeWidth=2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="b5"><mxGeometry x="263" y="38" width="220" height="62" as="geometry"/></mxCell><mxCell id="sys_84" value='&lt;b&gt;PII Restore + DLP&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;detokenise only at egress&lt;br&gt;scan the outbound text&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="b5"><mxGeometry x="499" y="38" width="220" height="62" as="geometry"/></mxCell><mxCell id="sys_85" value='&lt;b&gt;Response Composer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;Indic text or voice&lt;br&gt;HEDGE banner + undo link&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="b5"><mxGeometry x="735" y="38" width="220" height="62" as="geometry"/></mxCell><mxCell id="sys_86" value='&lt;b&gt