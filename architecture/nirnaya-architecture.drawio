or=#3A4556;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6018518518518519;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_86" target="aws"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1902" y="935"/><mxPoint x="1902" y="380"/></Array></mxGeometry></mxCell><mxCell id="sys_155" value="metrics ⇄ labels" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.8491228070175438;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="sup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="inv" value="ARCHITECTURAL INVARIANTS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#3A4556;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="1204" width="1290" height="150" as="geometry"/></mxCell><mxCell id="sys_156" value='&lt;b&gt;① Agents think, executors act&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;model output is advisory and schema-typed; only executors touch state&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="inv"><mxGeometry x="14" y="34" width="412" height="50" as="geometry"/></mxCell><mxCell id="sys_157" value='&lt;b&gt;② PII never reaches a model&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;tokenised at ingress, restored only at egress by deterministic code&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="inv"><mxGeometry x="438" y="34" width="412" height="50" as="geometry"/></mxCell><mxCell id="sys_158" value='&lt;b&gt;③ No unverified outcome is shown to a human&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;Recheck on the shadow state runs before every approval request&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="inv"><mxGeometry x="862" y="34" width="412" height="50" as="geometry"/></mxCell><mxCell id="sys_159" value='&lt;b&gt;④ No approval outlives its state&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;any change to payload, recheck, ledger or policy breaks the Seal&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="inv"><mxGeometry x="14" y="90" width="412" height="50" as="geometry"/></mxCell><mxCell id="sys_160" value='&lt;b&gt;⑤ Nothing is lost on restart&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;every superstep checkpointed; parked cases resume intact&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="inv"><mxGeometry x="438" y="90" width="412" height="50" as="geometry"/></mxCell><mxCell id="sys_161" value='&lt;b&gt;⑥ Fail closed&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;drift, out-of-distribution input or rail disagreement ⇒ escalate&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="inv"><mxGeometry x="862" y="90" width="412" height="50" as="geometry"/></mxCell><mxCell id="uspbox" value="★ WHAT NO ONE ELSE SHIPS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D69E00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#9A7000;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1330" y="1204" width="1270" height="150" as="geometry"/></mxCell><mxCell id="sys_162" value="★ &lt;b&gt;Conformal risk control&lt;/b&gt; — a guaranteed ceiling on wrong auto-resolutions" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="uspbox"><mxGeometry x="14" y="32" width="624" height="22" as="geometry"/></mxCell><mxCell id="sys_163" value="★ &lt;b&gt;Money-weighted autonomy&lt;/b&gt; — ₹-at-risk sets the threshold, per action type" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="uspbox"><mxGeometry x="14" y="54" width="624" height="22" as="geometry"/></mxCell><mxCell id="sys_164" value="★ &lt;b&gt;Earned autonomy&lt;/b&gt; — promoted only on shadow-mode evidence" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="uspbox"><mxGeometry x="14" y="76" width="624" height="22" as="geometry"/></mxCell><mxCell id="sys_165" value="★ &lt;b&gt;Verify-before-gate&lt;/b&gt; — humans only see outcomes that passed Recheck" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="uspbox"><mxGeometry x="14" y="98" width="624" height="22" as="geometry"/></mxCell><mxCell id="sys_166" value="★ &lt;b&gt;Seal&lt;/b&gt; — approval bound to payload, recheck, ledger and policy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="uspbox"><mxGeometry x="14" y="120" width="624" height="22" as="geometry"/></mxCell><mxCell id="sys_167" value="★ &lt;b&gt;Continuum&lt;/b&gt; — parked approvals survive restarts and deploys" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="uspbox"><mxGeometry x="642" y="32" width="624" height="22" as="geometry"/></mxCell><mxCell id="sys_168" value="★ &lt;b&gt;Exactly-once commit&lt;/b&gt; — a retry can never double-refund" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="uspbox"><mxGeometry x="642" y="54" width="624" height="22" as="geometry"/></mxCell><mxCell id="sys_169" value="★ &lt;b&gt;PII tokeniser&lt;/b&gt; — format-preserving; the model never sees raw PII" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="uspbox"><mxGeometry x="642" y="76" width="624" height="22" as="geometry"/></mxCell><mxCell id="sys_170" value="★ &lt;b&gt;Promise Guard&lt;/b&gt; — replies can't promise what policy doesn't allow" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="uspbox"><mxGeometry x="642" y="98" width="624" height="22" as="geometry"/></mxCell><mxCell id="sys_171" value="★ &lt;b&gt;Fail-closed drift&lt;/b&gt; + &lt;b&gt;counterfactual packets&lt;/b&gt; for agents" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fon