#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=10;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="loop_51"><mxGeometry x="14" y="82" width="326" height="44" as="geometry"/></mxCell><mxCell id="loop_54" value='&lt;b&gt;Out of distribution&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;Sentry anomaly score ⇒ escalate, whatever p says&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=10;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="loop_51"><mxGeometry x="14" y="130" width="326" height="44" as="geometry"/></mxCell><mxCell id="loop_55" value='&lt;b&gt;Shadow change had no effect&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;stop — do not retry an idle plan&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=10;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="loop_51"><mxGeometry x="14" y="178" width="326" height="44" as="geometry"/></mxCell><mxCell id="loop_56" value='&lt;b&gt;Same finding or plan fingerprint&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;stop the repair loop&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=10;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="loop_51"><mxGeometry x="14" y="226" width="326" height="44" as="geometry"/></mxCell><mxCell id="loop_57" value='&lt;b&gt;Three rounds exhausted&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;escalate with all three attempts attached&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=10;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="loop_51"><mxGeometry x="14" y="274" width="326" height="44" as="geometry"/></mxCell><mxCell id="loop_58" value='&lt;b&gt;Reject&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;report only — no action, label written&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=10;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="loop_51"><mxGeometry x="14" y="322" width="326" height="44" as="geometry"/></mxCell><mxCell id="loop_59" value='&lt;b&gt;Revise&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;seal voided; consumes one remaining round&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=10;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="loop_51"><mxGeometry x="14" y="370" width="326" height="44" as="geometry"/></mxCell><mxCell id="loop_60" value='&lt;b&gt;Seal broken at commit&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;re-request approval on the new state&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=10;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="loop_51"><mxGeometry x="14" y="418" width="326" height="44" as="geometry"/></mxCell><mxCell id="loop_61" value='&lt;b&gt;Policy graph redeployed&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;parked cases re-validate before resume&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=10;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="loop_51"><mxGeometry x="14" y="466" width="326" height="44" as="geometry"/></mxCell><mxCell id="loop_62" value="RETRY POLICY" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4556;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#3A4556;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1628" y="632" width="352" height="150" as="geometry"/></mxCell><mxCell id="loop_63" value='&lt;ul style="margin:3px 0 0 0;padding-left:15px;font-size:10px;line-height:1.35"&gt;&lt;li&gt;&lt;b&gt;Transient&lt;/b&gt; — tool timeout, rail API 5xx: 2 attempts, bounded backoff&lt;/li&gt;&lt;li&gt;&lt;b&gt;Policy / validation&lt;/b&gt; — never retried; surfaced as-is&lt;/li&gt;&lt;li&gt;&lt;b&gt;Repair&lt;/b&gt; — only while state changes, ≤ 3 rounds&lt;/li&gt;&lt;li&gt;&lt;b&gt;Commit&lt;/b&gt; — idempotent, so a retry is always safe&lt;/li&gt;&lt;/ul&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="loop_62"><mxGeometry x="14" y="30" width="326" height="112" as="geometry"/></mxCell><mxCell id="loop_64" value="" style="rounded=1;arcSize=3;fillColor=#F6F8FB;strokeColor=#C9D2DE;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1960" height="172" as="geometry"/></mxCell><mxCell id="loop_65" value="&lt;b&gt;Why this shape&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="912" width="1920" height="26" as="geometry"/></mxCell><mxCell id="loop_66" value="&lt;b&gt;The checker is the fixer's judge&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#1B2330&quot;&gt;Step ⑫ re-runs the exact checks from steps ⑤–⑦. There is one implementation, so checker and fixer cannot drift apart. A model never grades its own work.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DE;strokeWidth=1;fontSize=12;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="944" width="466" height="112" as="geometry"/></mxCell><mxCell id="loop_67" value="&lt;b&gt;Humans audit, they don't debug&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#1B2330&quot;&gt;Step ⑮ is only reached after ⑬ has passed. The approver sees a verified before/after diff, not a proposal and a promise.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DE;strokeWidth=1;fontSize=12;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="522" y="944" width="466" height="112" as="geometry"/></mxCell><mxCell id="loop_68" value='&lt;b&gt;The interrupt carries the seal&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#1B2330"&gt;The parked approval is keyed by case id + seal. A response to a stale seal cannot resolve a newer state — it is simply not the same interrupt.&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DE;strokeWidth=1;fontSize=12;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1004" y="944" width="466" height="112" as="geometry"/></mxCell><mxCell id="loop_69" value='&lt;b&gt;Every loop is bounded&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#1B2330"&gt;Re-plan ≤ 3, transient retry ≤ 2, and every loop stops on a repeated fingerprint. The worst case has a known cost.&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DE;strokeWidth=1;fontSize=12;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1486" y="944" width="466" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rt" name="A3 · Durable runtime"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1240" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rt_1" value="&lt;b&gt;NIRNAY&lt;/b&gt; · Continuum — the durable runtime underneath every case" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1800" height="34" as="geometry"/></mxCell><mxCell id="rt_2" value="superstep execution · three interception layers · the Seal lifecycle · what a checkpoint holds" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#56657A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1800" height="22" as="geometry"/></mxCell><mxCell id="rt_3" value="SUPERSTEP EXECUTION" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFCFF;strokeColor=#2F6FDE;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#2F6FDE;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="640" height="770" as="geometry"/></mxCell><mxCell id="rt_4" value="&lt;b&gt;Superstep N — executors run in parallel&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#2F6FDE;container=1;collapsible=0;recursiveResize=0;fontSize=11;" vertex="1" parent="rt_3"><mxGeometry x="20" y="36" width="600" height="92" as="geometry"/></mxCell><mxCell id="rt_5" value="&lt;b&gt;Evidence: debit rail&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_4"><mxGeometry x="20" y="30" width="178" height="50" as="geometry"/></mxCell><mxCell id="rt_6" value="&lt;b&gt;Evidence: credit rail&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_4"><mxGeometry x="212" y="30" width="178" height="50" as="geometry"/></mxCell><mxCell id="rt_7" value="&lt;b&gt;Policy retrieval&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_4"><mxGeometry x="404" y="30" width="178" height="50" as="geometry"/></mxCell><mxCell id="rt_8" value="barrier — messages delivered · state committed atomically" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DDE7FB;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#2F6FDE;align=center;verticalAlign=middle;" vertex="1" parent="rt_3"><mxGeometry x="20" y="140" width="600" height="24" as="geometry"/></mxCell><mxCell id="rt_9" value='&lt;b&gt;checkpoint C&lt;sub&gt;n&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;prev = C&lt;sub&gt;n−1&lt;/sub&gt; · policy hash&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FFF6D5;strokeColor=#D69E00;strokeWidth=2;fontSize=11;fontColor=#1B2330;verticalAlign=middle;" vertex="1" parent="rt_3"><mxGeometry x="230" y="174" width="180" height="50" as="geometry"/></mxCell><mxCell id="rt_10" value="&lt;b&gt;Superstep N+1 … N+k — plan · calibrate · shadow · recheck&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#2F6FDE;container=1;collapsible=0;recursiveResize=0;fontSize=11;" vertex="1" parent="rt_3"><mxGeometry x="20" y="240" width="600" height="92" as="geometry"/></mxCell><mxCell id="rt_11" value="&lt;b&gt;Plan&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_10"><mxGeometry x="20" y="30" width="178" height="50" as="geometry"/></mxCell><mxCell id="rt_12" value="&lt;b&gt;Shadow Execute&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_10"><mxGeometry x="212" y="30" width="178" height="50" as="geometry"/></mxCell><mxCell id="rt_13" value="&lt;b&gt;Recheck&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_10"><mxGeometry x="404" y="30" width="178" height="50" as="geometry"/></mxCell><mxCell id="rt_14" value='&lt;b&gt;checkpoint C&lt;sub&gt;k&lt;/sub&gt; — pending: seal request&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;the case is now parked, not running&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FFF6D5;strokeColor=#D69E00;strokeWidth=2;fontSize=11;fontColor=#1B2330;verticalAlign=middle;" vertex="1" parent="rt_3"><mxGeometry x="180" y="350" width="280" height="60" as="geometry"/></mxCell><mxCell id="rt_15" value='&lt;b&gt;process exits · deploy · node loss&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#D93F3F"&gt;nothing in memory is needed to continue&lt;/span&gt;' style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFE5E5;strokeColor=none;fontSize=11;fontStyle=1;fontColor=#D93F3F;align=center;verticalAlign=middle;fontStyle=0;strokeColor=#D93F3F;dashed=1;" vertex="1" parent="rt_3"><mxGeometry x="40" y="436" width="560" height="54" as="geometry"/></mxCell><mxCell id="rt_16" value='&lt;b&gt;resume( checkpoint = C&lt;sub&gt;k&lt;/sub&gt;, response = approval )&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;graph hash must match · seal must still hold&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3FBF6;strokeColor=#2E8B57;strokeWidth=1.5;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_3"><mxGeometry x="40" y="510" width="560" height="54" as="geometry"/></mxCell><mxCell id="rt_17" value="&lt;b&gt;Superstep k+1 — commit · respond · report&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#2F6FDE;container=1;collapsible=0;recursiveResize=0;fontSize=11;" vertex="1" parent="rt_3"><mxGeometry x="20" y="586" width="600" height="92" as="geometry"/></mxCell><mxCell id="rt_18" value="&lt;b&gt;Commit&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_17"><mxGeometry x="20" y="30" width="178" height="50" as="geometry"/></mxCell><mxCell id="rt_19" value="&lt;b&gt;Guard &amp;amp; Respond&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_17"><mxGeometry x="212" y="30" width="178" height="50" as="geometry"/></mxCell><mxCell id="rt_20" value="&lt;b&gt;Trace &amp;amp; Label&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_17"><mxGeometry x="404" y="30" width="178" height="50" as="geometry"/></mxCell><mxCell id="rt_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt_4" target="rt_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rt_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt_8" target="rt_9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rt_23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt_9" target="rt_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rt_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt_10" target="rt_14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rt_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt_14" target="rt_15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rt_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt_15" target="rt_16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rt_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt_16" target="rt_17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rt_28" value='&lt;span style="font-size:10px;color:#1B2330"&gt;A checkpoint is written at every superstep boundary, never mid-step, so a resume can never observe a half-applied state. Checkpoints are chained by &lt;b&gt;previous_checkpoint_id&lt;/b&gt; and stamped with the &lt;b&gt;policy graph hash&lt;/b&gt;; a resume against a different graph is refused and re-validated.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="rt_3"><mxGeometry x="20" y="690" width="600" height="70" as="geometry"/></mxCell><mxCell id="rt_29" value="THREE INTERCEPTION LAYERS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFBFB;strokeColor=#D93F3F;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#D93F3F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="690" y="90" width="600" height="520" as="geometry"/></mxCell><mxCell id="rt_30" value='&lt;b&gt;CASE LAYER&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;AuthZ &amp;amp; consent · Sentry · injection fence · budget &amp;amp; rate limits&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#D93F3F;strokeWidth=1.4;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;verticalAlign=top;spacingTop=6;" vertex="1" parent="rt_29"><mxGeometry x="22" y="38" width="556" height="468" as="geometry"/></mxCell><mxCell id="rt_31" value='&lt;b&gt;MODEL LAYER&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;PII tokenised before every call · response scanned · tokens metered&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6EC;strokeColor=#E8771A;strokeWidth=1.4;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;verticalAlign=top;spacingTop=6;" vertex="1" parent="rt_29"><mxGeometry x="52" y="102" width="496" height="380" as="geometry"/></mxCell><mxCell id="rt_32" value='&lt;b&gt;TOOL LAYER&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;Tool Guard validates arguments before the tool runs&lt;br&gt;approval declared on the tool · idempotency key attached&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6D5;strokeColor=#D69E00;strokeWidth=1.6;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;verticalAlign=top;spacingTop=6;" vertex="1" parent="rt_29"><mxGeometry x="82" y="166" width="436" height="292" as="geometry"/></mxCell><mxCell id="rt_33" value='&lt;b&gt;specialist or executor&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;sees only what every layer above let through&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.6;fontSize=12;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_29"><mxGeometry x="152" y="254" width="296" height="80" as="geometry"/></mxCell><mxCell id="rt_34" value="amount ≤ policy cap for this action" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#1B2330;align=center;verticalAlign=middle;fontStyle=0;strokeColor=#D69E00;strokeWidth=1;" vertex="1" parent="rt_29"><mxGeometry x="100" y="350" width="204" height="28" as="geometry"/></mxCell><mxCell id="rt_35" value="account token owned by this customer" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#1B2330;align=center;verticalAlign=middle;fontStyle=0;strokeColor=#D69E00;strokeWidth=1;" vertex="1" parent="rt_29"><mxGeometry x="312" y="350" width="204" height="28" as="geometry"/></mxCell><mxCell id="rt_36" value="idempotency key present and unused" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#1B2330;align=center;verticalAlign=middle;fontStyle=0;strokeColor=#D69E00;strokeWidth=1;" vertex="1" parent="rt_29"><mxGeometry x="100" y="384" width="204" height="28" as="geometry"/></mxCell><mxCell id="rt_37" value="seal matches — or the tool does not run" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#1B2330;align=center;verticalAlign=middle;fontStyle=0;strokeColor=#D69E00;strokeWidth=1;" vertex="1" parent="rt_29"><mxGeometry x="312" y="384" width="204" height="28" as="geometry"/></mxCell><mxCell id="rt_38" value='&lt;span style="font-size:10px;color:#1B2330"&gt;Each layer can terminate the call and substitute a safe response. A termination is a normal outcome with an audit event — not an exception bubbling out of a stack.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="712" y="612" width="576" height="56" as="geometry"/></mxCell><mxCell id="rt_39" value='&lt;div style="font-family:DejaVu Sans Mono,monospace;font-size:10px;text-align:left;line-height:1.45"&gt;&lt;span style="color:#9A7000"&gt;@requires_approval&lt;/span&gt;(mode=&lt;span style="color:#1E9E5A"&gt;"always"&lt;/span&gt;)&lt;br&gt;&lt;span style="color:#2F6FDE"&gt;def&lt;/span&gt; submit_refund(order_id, amount: Decimal,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;reason) -&amp;gt; RefundReceipt: ...&lt;/div&gt;' style="rounded=1;arcSize=6;fillColor=#1B2330;strokeColor=none;fontColor=#E7EAEE;html=1;whiteSpace=wrap;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="690" width="600" height="90" as="geometry"/></mxCell><mxCell id="rt_40" value='&lt;span style="font-size:10px;color:#1B2330"&gt;A prompt instruction can be argued out of a model. A declaration at the call site cannot — the Tool Layer refuses to run it without a matching Seal.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="690" y="784" width="600" height="60" as="geometry"/></mxCell><mxCell id="rt_41" value="SEAL LIFECYCLE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D69E00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#9A7000;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1320" y="90" width="660" height="770" as="geometry"/></mxCell><mxCell id="rt_42" value="&lt;b&gt;Executor&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A7000;strokeWidth=1.2;fontSize=10;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_41"><mxGeometry x="4" y="36" width="92" height="40" as="geometry"/></mxCell><mxCell id="rt_43" value="" style="endArrow=none;endFill=1;html=1;strokeColor=#C4A660;strokeWidth=1;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1370" y="166" as="sourcePoint"/><mxPoint x="1370" y="664" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rt_44" value="&lt;b&gt;Shadow&lt;br&gt;Ledger&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A7000;strokeWidth=1.2;fontSize=10;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_41"><mxGeometry x="116" y="36" width="92" height="40" as="geometry"/></mxCell><mxCell id="rt_45" value="" style="endArrow=none;endFill=1;html=1;strokeColor=#C4A660;strokeWidth=1;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1482" y="166" as="sourcePoint"/><mxPoint x="1482" y="664" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rt_46" value="&lt;b&gt;Seal&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A7000;strokeWidth=1.2;fontSize=10;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="rt_41"><mxGeometry x="228" y="36" width="92" height="40" as="geometry"/></mxCell><mxCell id="rt_47" value="" style="endArrow=none;endFill=1;html=1;strokeColor=#C4A660;strokeWidth=1;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1594" y="166" as="sourcePoint"/><mxPoint x="1594" y="664" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rt_48" value="&lt;b&gt;Continuum&lt;/b&gt;" style="rounde