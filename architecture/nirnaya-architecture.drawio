'&lt;span style="font-size:9px;color:#56657A"&gt;illustrative — the real curve is produced from the ambiguity eval set in phase P4&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36" y="684" width="590" height="30" as="geometry"/></mxCell><mxCell id="dec_59" value="★ EARNED AUTONOMY — promoted by evidence, demoted by drift" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D69E00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#9A7000;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="670" y="250" width="640" height="470" as="geometry"/></mxCell><mxCell id="dec_60" value="&lt;b&gt;0 · SHADOW&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B2330&quot;&gt;predicts every case, acts on none; decisions logged beside the human's&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8894A6;strokeWidth=2;fontSize=12;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="dec_59"><mxGeometry x="30" y="362" width="250" height="72" as="geometry"/></mxCell><mxCell id="dec_61" value='&lt;b&gt;1 · DRAFT&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1B2330"&gt;prepares the action and the reply; a human sends both&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=2;fontSize=12;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="dec_59"><mxGeometry x="70" y="260" width="250" height="72" as="geometry"/></mxCell><mxCell id="dec_62" value='&lt;b&gt;2 · HEDGE&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1B2330"&gt;acts on low-₹ cases with uncertainty stated and undo attached&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0A100;strokeWidth=2;fontSize=12;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="dec_59"><mxGeometry x="110" y="158" width="250" height="72" as="geometry"/></mxCell><mxCell id="dec_63" value='&lt;b&gt;3 · ACT&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1B2330"&gt;acts, verifies, commits — a human sees it only in the metrics&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=2;fontSize=12;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="dec_59"><mxGeometry x="150" y="56" width="250" height="72" as="geometry"/></mxCell><mxCell id="dec_64" value="promote" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E9E5A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_60" target="dec_61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_65" value="promote" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E9E5A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_61" target="dec_62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_66" value="promote" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E9E5A;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_62" target="dec_63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_67" value="demote on drift" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D93F3F;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_63" target="dec_60"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="686" y="342"/><mxPoint x="686" y="648"/></Array></mxGeometry></mxCell><mxCell id="dec_68" value='&lt;b&gt;Promote a rung only when, on ≥ N live cases:&lt;/b&gt;&lt;ul style="margin:3px 0 0 0;padding-left:15px;font-size:10px;line-height:1.35"&gt;&lt;li&gt;conformal coverage ≥ 1 − α&lt;/li&gt;&lt;li&gt;ECE ≤ ε&lt;/li&gt;&lt;li&gt;undo rate ≤ u&lt;/li&gt;&lt;li&gt;zero Promise Guard violations&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;b&gt;Demote automatically when:&lt;/b&gt;&lt;ul style="margin:3px 0 0 0;padding-left:15px;font-size:10px;line-height:1.35"&gt;&lt;li&gt;rolling coverage falls below target&lt;/li&gt;&lt;li&gt;rail-disagreement rate spikes&lt;/li&gt;&lt;li&gt;a new dispute pattern appears (OOD)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D69E00;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#1B2330;" vertex="1" parent="dec_59"><mxGeometry x="414" y="50" width="212" height="226" as="geometry"/></mxCell><mxCell id="dec_69" value="★ MONEY-WEIGHTED THRESHOLDS — illustrative" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D69E00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#9A7000;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1340" y="250" width="640" height="470" as="geometry"/>