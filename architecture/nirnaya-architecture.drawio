one;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;spacingLeft=10;" vertex="1" parent="rt_82"><mxGeometry x="420" y="254" width="830" height="36" as="geometry"/></mxCell><mxCell id="rt_104" value="" style="rounded=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="rt_82"><mxGeometry x="20" y="290" width="1230" height="36" as="geometry"/></mxCell><mxCell id="rt_105" value='&lt;span style="font-family:DejaVu Sans Mono,monospace;color:#2E8B57"&gt;trace_context&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;spacingLeft=10;" vertex="1" parent="rt_82"><mxGeometry x="20" y="290" width="400" height="36" as="geometry"/></mxCell><mxCell id="rt_106" value="resumed spans join the original trace, so one case is one trace" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;spacingLeft=10;" vertex="1" parent="rt_82"><mxGeometry x="420" y="290" width="830" height="36" as="geometry"/></mxCell><mxCell id="rt_107" value="THE SEAL" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D69E00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#9A7000;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1320" y="880" width="660" height="340" as="geometry"/></mxCell><mxCell id="rt_108" value='&lt;span style="font-family:DejaVu Sans Mono,monospace;font-size:15px"&gt;&lt;b&gt;seal&lt;/b&gt; = H( payload ‖ recheck ‖ ledger_version ‖ policy_hash )&lt;/span&gt;' style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#1B2330;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#FFE69A;align=center;verticalAlign=middle;fontStyle=0;" vertex="1" parent="rt_107"><mxGeometry x="20" y="36" width="620" height="52" as="geometry"/></mxCell><mxCell id="rt_109" value='&lt;span style="font-family:DejaVu Sans Mono,monospace;color:#9A7000"&gt;&lt;b&gt;payload&lt;/b&gt;&lt;/span&gt; — the exact action — amount, account token, reason' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6C66A;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="rt_107"><mxGeometry x="20" y="100" width="620" height="42" as="geometry"/></mxCell><mxCell id="rt_110" value='&lt;span style="font-family:DejaVu Sans Mono,monospace;color:#9A7000"&gt;&lt;b&gt;recheck&lt;/b&gt;&lt;/span&gt; — the verification result the human was shown' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6C66A;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="rt_107"><mxGeometry x="20" y="148" width="620" height="42" as="geometry"/></mxCell><mxCell id="rt_111" value='&lt;span style="font-family:DejaVu Sans Mono,monospace;color:#9A7000"&gt;&lt;b&gt;ledger_version&lt;/b&gt;&lt;/span&gt; — the shadow version the action was computed against' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6C66A;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="rt_107"><mxGeometry x="20" y="196" width="620" height="42" as="geometry"/></mxCell><mxCell id="rt_112" value='&lt;span style="font-family:DejaVu Sans Mono,monospace;color:#9A7000"&gt;&lt;b&gt;policy_hash&lt;/b&gt;&lt;/span&gt; — the policy graph the decision was made under' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6C66A;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="rt_107"><mxGeometry x="20" y="244" width="620" height="42" as="geometry"/></mxCell><mxCell id="rt_113" value='&lt;span style="font-size:11px;color:#1B2330"&gt;Change any one of the four and the approval no longer applies.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="rt_107"><mxGeometry x="20" y="296" width="620" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dec" name="A4 · Decision science"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dec_1" value="&lt;b&gt;NIRNAY&lt;/b&gt; · Decision Science — from a confidence score to a guarantee with a price" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1800" height="34" as="geometry"/></mxCell><mxCell id="dec_2" value="calibrate → bound the error → weigh the money → earn the autonomy → fail closed on drift" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#56657A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1800" height="22" as="geometry"/></mxCell><mxCell id="dec_3" value='&lt;b&gt;Confidence Features&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#56657A"&gt;retrieval score · source trust&lt;br&gt;rail agreement · recheck prior&lt;br&gt;intent history&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="300" height="110" as="geometry"/></mxCell><mxCell id="dec_4" value='&lt;b&gt;Calibrate&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#56657A"&gt;p̂ = σ(z / T)&lt;br&gt;temperature · isotonic&lt;br&gt;preference-tuned head&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="300" height="110" as="geometry"/></mxCell><mxCell id="dec_5" value='&lt;b&gt;★ Conformal Risk Control&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#56657A"&gt;λ̂ = inf{ λ : n⁄(n+1)·R̂ₙ(λ) + B⁄(n+1) ≤ α }&lt;br&gt;⇒ E[ wrong auto-rate ] ≤ α&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6D5;strokeColor=#D69E00;strokeWidth=2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="300" height="110" as="geometry"/></mxCell><mxCell id="dec_6" value='&lt;b&gt;★ Money-Weighted Rule&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#56657A"&gt;ACT iff (1 − p̂) · C&lt;sub&gt;wrong&lt;/sub&gt;(₹)&lt;br&gt;&amp;lt; C&lt;sub&gt;human&lt;/sub&gt;&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6D5;strokeColor=#D69E00;strokeWidth=2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="300" height="110" as="geometry"/></mxCell><mxCell id="dec_7" value='&lt;b&gt;★ Autonomy Rung&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#56657A"&gt;what this action type&lt;br&gt;has earned so far&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6D5;strokeColor=#D69E00;strokeWidth=2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1340" y="100" width="300" height="110" as="geometry"/></mxCell><mxCell id="dec_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColo