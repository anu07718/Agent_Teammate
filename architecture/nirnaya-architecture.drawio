geometry"/></mxCell><mxCell id="stack_34" value='&lt;b&gt;How Nirnaya uses it&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#1B2330"&gt;Pydantic models at every service boundary — a malformed plan is rejected by the type, not by a prompt. Continuum runs each case as supersteps and checkpoints every one; the Tool gateway is the only path to live systems.&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#DCE3EC;strokeWidth=1;fontSize=13;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;verticalAlign=middle;spacing=14;" vertex="1" parent="stack_19"><mxGeometry x="1264" y="14" width="682" height="122" as="geometry"/></mxCell><mxCell id="stack_35" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DE;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#C9D2DE;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="412" width="1960" height="150" as="geometry"/></mxCell><mxCell id="stack_36" value="&lt;b&gt;DATA &amp;amp; EVENTS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#2F6FDE;fontStyle=0;" vertex="1" parent="stack_35"><mxGeometry x="16" y="14" width="250" height="30" as="geometry"/></mxCell><mxCell id="stack_37" value='&lt;span style="font-size:11px;color:#1B2330"&gt;Cases · Shadow Ledger · checkpoints · hash-chained trail · evidence · rail events&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;verticalAlign=top;" vertex="1" parent="stack_35"><mxGeometry x="16" y="46" width="250" height="90" as="geometry"/></mxCell><mxCell id="stack_38" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" p