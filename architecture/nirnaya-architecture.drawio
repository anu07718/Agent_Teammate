;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#C9D2DE;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="1960" height="150" as="geometry"/></mxCell><mxCell id="stack_52" value="&lt;b&gt;DECISION &amp;amp; ML&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#2F6FDE;fontStyle=0;" vertex="1" parent="stack_51"><mxGeometry x="16" y="14" width="250" height="30" as="geometry"/></mxCell><mxCell id="stack_53" value='&lt;span style="font-size:11px;color:#1B2330"&gt;&amp;lt;200 ms CPU risk scoring · calibrated + conformal routing · self-hosted LLM serving&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;verticalAlign=top;" vertex="1" parent="stack_51"><mxGeometry x="16" y="46" width="250" height="90" as="geometry"/></mxCell><mxCell id="stack_54" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="336.0" y="596" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_55" value="PyTorch" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="306" y="650" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_56" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="452.0" y="596" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_57" value="scikit-learn" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="422" y="650" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_58" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="568.0" y="596" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_59" value="ONNX" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="538" y="650" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_60" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="684.0" y="596" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_61" value="NumPy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="654" y="650" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_62" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,PHN2ZyBmaWxsPSIjMzBBMkZGIiByb2xlPSJpbWciIHZpZXdCb3g9IjAgMCAyNCAyNCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48dGl0bGU+dkxMTTwvdGl0bGU+PHBhdGggZD0ibTIzLjYgMC04LjcyMSA0LjU5TDkuODI5IDI0aDcuNDF6TTkuODMgMjRWNS4xNDJILjRaIi8+PC9zdmc+;" vertex="1" parent="1"><mxGeometry x="800.0" y="596" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_63" value="vLLM" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="650" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_64" value="&lt;b&gt;XGB&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#1A73B8;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="916.0" y="596" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_65" value="XGBoost" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="886" y="650" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_66" value="&lt;b&gt;SHAP&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E0457B;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1032.0" y="596" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_67" value="SHAP" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1002" y="650" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_68" value="&lt;b&gt;CP&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D69E00;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1148.0" y="596" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_69" value="MAPIE · conformal" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1118" y="650" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_70" value="&lt;b&gt;How Nirnaya uses it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#1B2330&quot;&gt;Sentry's cascade (XGBoost + an encoder) is exported to ONNX for &amp;lt;200 ms CPU scoring. scikit-learn calibrates, MAPIE produces conformal sets, SHAP explains each score to the agent, vLLM serves the reasoning model in-house.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#DCE3EC;strokeWidth=1;fontSize=13;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;verticalAlign=middle;spacing=14;" vertex="1" parent="stack_51"><mxGeometry x="1264" y="14" width="682" height="122" as="geometry"/></mxCell><mxCell id="stack_71" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DE;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#C9D2DE;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="728" width="1960" height="150" as="geometry"/></mxCell><mxCell id="stack_72" value="&lt;b&gt;TRUST &amp;amp; SECURITY&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#2F6FDE;fontStyle=0;" vertex="1" parent="stack_71"><mxGeometry x="16" y="14" width="250" height="30" as="geometry"/></mxCell><mxCell id="stack_73" value='&lt;span style="font-size:11px;color:#1B2330"&gt;Secrets &amp;amp; keys · policy-as-code authorization · PII tokenisation · approval sealing&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;verticalAlign=top;" vertex="1" parent="stack_71"><mxGeometry x="16" y="46" width="250" height="90" as="geometry"/></mxCell><mxCell id="stack_74" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="336.0" y="754" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_75" value="Vault" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="306" y="808" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_76" value="&lt;b&gt;OPA&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#566366;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="452.0" y="754" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_77" value="OPA · policy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="422" y="808" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_78" value="&lt;b&gt;PII&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D69E00;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="568.0" y="754" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_79" value="★ FF3-1 PII tokeniser" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="538" y="808" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_80" value="&lt;b&gt;SEAL&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D69E00;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="684.0" y="754" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_81" value="★ Seal" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="654" y="808" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_82" value="&lt;b&gt;IF&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D69E00;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800.0" y="754" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_83" value="★ Injection fence" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="808" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_84" value='&lt;b&gt;How Nirnaya uses it&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#1B2330"&gt;Vault holds the keys for the FF3-1 format-preserving tokeniser. OPA evaluates entitlement and consent as policy-as-code before any model call. Seal and the injection fence are small, deterministic and fully unit-tested.&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#DCE3EC;strokeWidth=1;fontSize=13;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;verticalAlign=middle;spacing=14;" vertex="1" parent="stack_71"><mxGeometry x="1264" y="14" width="682" height="122" as="geometry"/></mxCell><mxCell id="stack_85" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DE;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#C9D2DE;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="886" width="1960" height="150" as="geometry"/></mxCell><mxCell id="stack_86" value="&lt;b&gt;OBSERVABILITY&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#2F6FDE;fontStyle=0;" vertex="1" parent="stack_85"><mxGeometry x="16" y="14" width="250" height="30" as="geometry"/></mxCell><mxCell id="stack_87" value='&lt;span style="font-size:11px;color:#1B2330"&gt;Every superstep, tool and model call traced · live ECE, deflection, ₹/resolution&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;verticalAlign=top;" vertex="1" parent="stack_85"><mxGeometry x="16" y="46" width="250" height="90" as="geometry"/></mxCell><mxCell id="stack_88" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="336.0" y="912" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_89" value="OpenTelemetry" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="306" y="966" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_90" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="452.0" y="912" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_91" value="Prometheus" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="422" y="966" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_92" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="568.0" y="912" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_93" value="Grafana" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="538" y="966" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_94" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="684.0" y="912" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_95" value="Jaeger" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="654" y="966" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_96" value="&lt;b&gt;How Nirnaya uses it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#1B2330&quot;&gt;One OpenTelemetry trace per case, carried across restarts. Prometheus scrapes ECE, deflection, escalation precision and ₹/resolution; Grafana is the supervisor's live view; Jaeger debugs a single superstep.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#DCE3EC;strokeWidth=1;fontSize=13;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;verticalAlign=middle;spacing=14;" vertex="1" parent="stack_85"><mxGeometry x="1264" y="14" width="682" height="122" as="geometry"/></mxCell><mxCell id="stack_97" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DE;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#C9D2DE;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="1044" width="1960" height="150" as="geometry"/></mxCell><mxCell id="stack_98" value="&lt;b&gt;DELIVERY &amp;amp; QUALITY&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#2F6FDE;fontStyle=0;" vertex="1" parent="stack_97"><mxGeometry x="16" y="14" width="250" height="30" as="geometry"/></mxCell><mxCell id="stack_99" value='&lt;span style="font-size:11px;color:#1B2330"&gt;Containerised · benchmark gate in CI blocks a regression before it ships&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;verticalAlign=top;" vertex="1" parent="stack_97"><mxGeometry x="16" y="46" width="250" height="90" as="geometry"/></mxCell><mxCell id="stack_100" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="336.0" y="1070" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_101" value="Docker" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="306" y="1124" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_102" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="452.0" y="1070" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_103" value="Kubernetes" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="422" y="1124" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_104" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="568.0" y="1070" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_105" value="Helm" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="538" y="1124" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_106" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="684.0" y="1070" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_107" value="GitHub Actions" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="654" y="1124" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_108" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="800.0" y="1070" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_109" value="Pytest" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="770" y="1124" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_110" value="&lt;b&gt;SIM&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D69E00;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="916.0" y="1070" width="52" height="52" as="geometry"/></mxCell><mxCell id="stack_111" value="★ Sim-customer bench" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="886" y="1124" width="112" height="26" as="geometry"/></mxCell><mxCell id="stack_112" value='&lt;b&gt;How Nirnaya uses it&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#1B2330"&gt;Docker images, Helm charts, Kubernetes. GitHub Actions runs Pytest, the adversarial twin fixtures and the simulated-customer benchmark — a pass^k regression blocks the deploy.&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#DCE3EC;strokeWidth=1;fontSize=13;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;verticalAlign=middle;spacing=14;" vertex="1" parent="stack_97"><mxGeometry x="1264" y="14" width="682" height="122" as="geometry"/></mxCell><mxCell id="stack_113" value='&lt;span style="font-size:11px;color:#1B2330"&gt;Deliberately absent: no hosted-only dependency, no single-vendor model API in the critical path, and no agent orchestration library — the runtime, gateway, Shadow Ledger and Seal are ours, which is why their guarantees are ours to state.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="1206" width="1960" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
