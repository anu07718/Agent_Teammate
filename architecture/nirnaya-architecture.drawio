-Weighted Threshold&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;act iff (1−p)·₹-at-risk&lt;br&gt;&amp;lt; cost of a human&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6D5;strokeColor=#D69E00;strokeWidth=2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="b3"><mxGeometry x="615" y="38" width="180" height="72" as="geometry"/></mxCell><mxCell id="sys_57" value='&lt;b&gt;★ Earned-Autonomy Dial&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;shadow → draft → hedge → act&lt;br&gt;per action type&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6D5;strokeColor=#D69E00;strokeWidth=2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="b3"><mxGeometry x="811" y="38" width="180" height="72" as="geometry"/></mxCell><mxCell id="sys_58" value='&lt;b&gt;4-State Router&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;one decision per case&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.6;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="b3"><mxGeometry x="1007" y="38" width="180" height="72" as="geometry"/></mxCell><mxCell id="sys_59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_53" target="sys_54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBack