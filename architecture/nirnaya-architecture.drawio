le="font-size:9px;color:#1B2330"&gt;⑩ match&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1598" y="525" width="366" height="16" as="geometry"/></mxCell><mxCell id="rt_74" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5B6B82;strokeWidth=1.3;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1594" y="576" as="sourcePoint"/><mxPoint x="1370" y="576" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rt_75" value='&lt;span style="font-size:9px;color:#1B2330"&gt;⑪ commit allowed&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1374" y="559" width="254" height="16" as="geometry"/></mxCell><mxCell id="rt_76" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5B6B82;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1370" y="610" as="sourcePoint"/><mxPoint x="1930" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rt_77" value='&lt;span style="font-size:9px;color:#1B2330"&gt;⑫ commit · idempotency key&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1374" y="593" width="590" height="16" as="geometry"/></mxCell><mxCell id="rt_78" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5B6B82;strokeWidth=1.3;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1930" y="644" as="sourcePoint"/><mxPoint x="1370" y="644" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rt_79" value='&lt;span style="font-size:9px;color:#1B2330"&gt;⑬ receipt + undo token&lt;/span&gt;' style="text;html=1