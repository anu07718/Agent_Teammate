left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;spacingLeft=10;" vertex="1" parent="dec_69"><mxGeometry x="388" y="240" width="76" height="40" as="geometry"/></mxCell><mxCell id="dec_99" value="DRAFT" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#2F6FDE;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="dec_69"><mxGeometry x="474" y="250.0" width="74" height="20" as="geometry"/></mxCell><mxCell id="dec_100" value="" style="rounded=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="dec_69"><mxGeometry x="16" y="280" width="608" height="40" as="geometry"/></mxCell><mxCell id="dec_101" value="KYC unblock" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;spacingLeft=10;" vertex="1" parent="dec_69"><mxGeometry x="16" y="280" width="262" height="40" as="geometry"/></mxCell><mxCell id="dec_102" value="compliance" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;spacingLeft=10;" vertex="1" parent="dec_69"><mxGeometry x="278" y="280" width="110" height="40" as="geometry"/></mxCell><mxCell id="dec_103" value="—" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;spacingLeft=10;" vertex="1" parent="dec_69"><mxGeometry x="388" y="280" width="76" height="40" as="geometry"/></mxCell><mxCell id="dec_104" value="SHADOW" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#8894A6;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="dec_69"><mxGeometry x="474" y="290.0" width="74" height="20" as="geometry"/></mxCell><mxCell id="dec_105" value='&lt;span style="font-size:11px;color:#1B2330"&gt;Same model, same confidence, different decisions: a 0.9 on a ₹200 reversal acts; a 0.9 on a ₹50,000 chargeback drafts. The threshold follows the money, and the supervisor can see what each one costs.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="dec_69"><mxGeometry x="16" y="344" width="608" height="110" as="geometry"/></mxCell><mxCell id="dec_106" value="FAIL-CLOSED DRIFT LOOP" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFBFB;strokeColor=#D93F3F;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#D93F3F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="1290" height="420" as="geometry"/></mxCell><mxCell id="dec_107" value='&lt;b&gt;Live outcomes&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#56657A"&gt;approvals · undos · reopen rate&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.5;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="dec_106"><mxGeometry x="50" y="70" width="250" height="80" as="geometry"/></mxCell><mxCell id="dec_108" value='&lt;b&gt;Rolling coverage&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#56657A"&gt;is P(wrong) still ≤ α?&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.5;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="dec_106"><mxGeometry x="340" y="70" width="250" height="80" as="geometry"/></mxCell><mxCell id="dec_109" value='&lt;b&gt;Compare to target&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#56657A"&gt;1 − α − margin&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FDE;strokeWidth=1.5;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="dec_106"><mxGeometry x="630" y="70" width="250" height="80" as="geometry"/></mxCell><mxCell id="dec_110" value='&lt;b&gt;Tighten&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#56657A"&gt;λ̂ up · rung down one&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93F3F;strokeWidth=1.5;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="dec_106"><mxGeometry x="920" y="70" width="250" height="80" as="geometry"/></mxCell><mxCell id="dec_111" value='&lt;b&gt;Alert supervisor&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#56657A"&gt;with the evidence&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93F3F;strokeWidth=1.5;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="dec_106"><mxGeometry x="920" y="240" width="250" height="80" as="geometry"/></mxCell><mxCell id="dec_112" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_107" target="dec_108"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_113" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_108" target="dec_109"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_114" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_109" target="dec_110"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_115" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_110" target="dec_111"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_116" value="within target — keep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8A6BFF;strokeWidth=1.4;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_109" target="dec_107"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="930"/><mxPoint x="195" y="930"/></Array></mxGeometry></mxCell><mxCell id="dec_117" value='&lt;span style="font-size:11px;color:#1B2330"&gt;The failure mode that matters is not a bad model — it is a &lt;b&gt;good model on a changed world&lt;/b&gt;. A new bank outage pattern, a festival-season spike, a policy change. Calibration measured last month says nothing about this month. So coverage is re-estimated continuously, and the only automatic direction is &lt;b&gt;towards caution&lt;/b&gt;: tightening is automatic, loosening requires a supervisor and fresh shadow-mode evidence.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2330;fontStyle=0;" vertex="1" parent="dec_106"><mxGeometry x="50" y="250" width="820" height="150" as="geometry"/></mxCell><mxCell id="dec_118" value="METRICS — defined, not waved at" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4556;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=22;spacingTop=5;fontStyle=1;fontSize=13;fontColor=#3A4556;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1340" y="750" width="640" height="420" as="geometry"/></mxCell><mxCell id="dec_119" value='&lt;b&gt;ECE&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1B2330"&gt;Σ (|B&lt;sub&gt;b&lt;/sub&gt;|/n) · |acc(B&lt;sub&gt;b&lt;/sub&gt;) − conf(B&lt;sub&gt;b&lt;/sub&gt;)| — how far stated confidence sits from reality&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="dec_118"><mxGeometry x="16" y="36" width="608" height="56" as="geometry"/></mxCell><mxCell id="dec_120" value='&lt;b&gt;Coverage&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1B2330"&gt;share of auto-resolved cases that were right — the quantity α bounds&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="dec_118"><mxGeometry x="16" y="98" width="608" height="56" as="geometry"/></mxCell><mxCell id="dec_121" value='&lt;b&gt;Escalation precision&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1B2330"&gt;share of escalations a human agreed needed a human&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="dec_118"><mxGeometry x="16" y="160" width="608" height="56" as="geometry"/></mxCell><mxCell id="dec_122" value='&lt;b&gt;Deflection&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1B2330"&gt;share of cases closed with no human touch&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="dec_118"><mxGeometry x="16" y="222" width="608" height="56" as="geometry"/></mxCell><mxCell id="dec_123" value='&lt;b&gt;pass^k&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1B2330"&gt;succeeds on all k repeated trials of a scenario — reliability, not luck&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="dec_118"><mxGeometry x="16" y="284" width="608" height="56" as="geometry"/></mxCell><mxCell id="dec_124" value='&lt;b&gt;Undo rate&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1B2330"&gt;share of commits later reversed — the honest ground truth&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#3A4556;strokeWidth=1;fontSize=11;fontColor=#1B2330;align=left;verticalAlign=middle;spacing=4;spacingLeft=10;" vertex="1" parent="dec_118"><mxGeometry x="16" y="346" width="608" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="stack" name="A5 · Tech stack — detail"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1270" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="stack_1" value="&lt;b&gt;NIRNAY&lt;/b&gt; · Tech Stack — open source end to end, self-hostable for data residency" style="text;html=1;whiteSpace=wrap;strokeColor