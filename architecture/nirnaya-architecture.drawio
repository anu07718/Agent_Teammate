"/></mxCell><mxCell id="sys_74" value='&lt;b&gt;★ Exactly-once Commit&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#56657A"&gt;idempotency key · saga compensation&lt;br&gt;undo token minted&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF6D5;strokeColor=#D69E00;strokeWidth=2;fontSize=11;fontColor=#1B2330;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="b4"><mxGeometry x="717" y="124" width="208" height="58" as="geometry"/></mxCell><mxCell id="sys_75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_69" target="sys_70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_76" value="resolved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_70" target="sys_71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontSize=9;fontColor=#3A4556;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys_71" target="sys_72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys_78" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6B82;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;f